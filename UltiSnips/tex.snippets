snippet ;aa "alpha" iA
\\alpha $0
endsnippet

context "math()"
snippet ;bt "beta" iA
\\beta $0
endsnippet

context "math()"
snippet ;gg "gamma" iA
\\gamma $0
endsnippet

context "math()"
snippet ;G "Gamma" iA
\\Gamma $0
endsnippet

context "math()"
snippet ;dd "delta" iA
\\delta $0
endsnippet

context "math()"
snippet ;D "Delta" iA
\\Delta $0
endsnippet

snippet ;ee "epsilon" iA
\\varepsilon $0
