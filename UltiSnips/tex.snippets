context "math()"
snippet ;hh "eta" iA
\\eta $0
endsnippet

context "math()"
snippet ;th "theta" iA
\\vartheta $0
endsnippet

context "math()"
snippet ;Th "Theta" iA
\\Theta $0
endsnippet

context "math()"
snippet ;ll "lambda" iA
\\lambda $0
endsnippet

context "math()"
snippet ;L "Lambda" iA
\\Lambda $0
endsnippet

context "math()"
snippet ;rr "rho" iA
\\rho $0
endsnippet

context "math()"
snippet ;ss "sigma" iA
\\sigma $0
endsnippet

context "math()"
snippet ;tt "tau" iA
\\tau $0
endsnippet

context "math()"
snippet ;vf "varphi" iA
\\varphi $0
endsnippet

context "math()"
snippet ;ff "phi" iA
\\phi $0
endsnippet

context "math()"
snippet ;F "Phi" iA
\\Phi $0
endsnippet

context "math()"
snippet ;ch "chi" iA
\\chi $0
endsnippet

context "math()"
snippet ;ps "psi" iA
\\psi $0
endsnippet

context "math()"
snippet ;Ps "Psi" iA
\\Psi $0
