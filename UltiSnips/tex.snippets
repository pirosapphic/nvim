global !p
def math():
    return vim.eval('vimtex#syntax#in_mathzone()') == '1'

endglobal

# General snippets
priority 0
snippet ;doc "document" iA
\\documentclass[a4]\{book\}
\\begin\{document\}
$0
\end{document}
endsnippet

snippet ;fig "figure" iA
\\begin\{figure\}[H]
    \\centering
    \\includegraphics[width = \\linewidth]\{$1\}
    \\caption\{$2\}
\\end\{figure\}
$0
endsnippet

snippet ;beg "begin" iA
\\begin\{$1\}
${2:${VISUAL:}}
\\end\{$1\}
$0
endsnippet

snippet ;sec "section" iA
\\section\{${1:${VISUAL:}}\}
$0
endsnippet

snippet ;ssec "subsection" iA
\\subsection\{${1:${VISUAL:}}\}
$0
endsnippet

snippet ;sssec "subsubsection" iA
\\subsubsection\{${1:${VISUAL:}}\}
$0
endsnippet

snippet ;box "makes simple box" iA
\\noindent\\fbox\{%
    \\parbox\{\\textwidth\}\{%
	${1:${VISUAL:}}
    \}%
\}
$0
endsnippet

snippet ;tbb "boldface" iA
\\textbf\{${1:${VISUAL:}}\}$0
endsnippet

snippet ;tii "italics" iA
\\textit\{${1:${VISUAL:}}\}$0
endsnippet

snippet ;rf "reference" iA
\\ref\{$1\}$0
endsnippet

snippet ;lb "label" iA
\\label\{$1\}$0
endsnippet

snippet ;ft "footnote" iA
\\footnote\{${1:${VISUAL:}}\}$0
endsnippet

snippet ;-- "line" iA
%------------------------------------------------------------------------------
$0
endsnippet

#------------------------------------------------------------------------------
#Math

snippet ;bbm "very big math visual" iA
\\begin\{${1:gather*}\}
	${2:${VISUAL:}}
\\end\{$1\}
$0
endsnippet

snippet ;bm "big math visual" iA
\\[
	${1:${VISUAL:}}
\\]$0
endsnippet

snippet ;mm "inline math visual" iA
\$${1:${VISUAL:}}\$ $0
endsnippet

context "math()"
snippet ;bx "box" iA
\\boxed\{${1:${VISUAL:}}\}$0
endsnippet

context "math()"
snippet ;mbf "mathbf" iA
\\mathbf\{${1:${VISUAL:}}\}$0
endsnippet

context "math()"
snippet ;mbb "mathbb" iA
\\mathbb\{${1:${VISUAL:}}\}$0
endsnippet

context "math()"
snippet ;mc "mathcal" iA
\\mathcal\{${1:${VISUAL:}}\}$0
endsnippet

context "math()"
snippet ;>= "geq" iA
\\geq $0
endsnippet

context "math()"
snippet ;<= "leq" iA
\\leq $0
endsnippet

context "math()"
snippet ;_ "pedix" iA
_\{${1:${VISUAL:}}\}$0
endsnippet

context "math()"
snippet ;^ "apex" iA
^\{${1:${VISUAL:}}\}$0
endsnippet

context "math()"
snippet ;ind "einstein indexes" iA
\\indices\{${1:${VISUAL:}}\}$0
endsnippet

context "math()"
snippet ;dg "dagger" iA
^\\dagger $0
endsnippet

context "math()"
snippet ;-> "rightarrow" iA
\\longrightarrow $0
endsnippet

context "math()"
snippet ;<-> "leftrightarrow" iA
\\longleftrightarrow $0
endsnippet


context "math()"
snippet ;=> "implication" iA
\\implies $0
endsnippet

context "math()"
snippet ;iff "if and only if" iA
\\iff $0
endsnippet

context "math()"
snippet ;. "dot product" iA
\\cdot $0
endsnippet

context "math()"
snippet ;int "integral" iA
\\int_\{$1\}^\{$2\} \\dd ${0:${VISUAL:}}
endsnippet

context "math()"
snippet ;fin "Feynman path integral" iA
\\int \\mathcal\{D\}${1:\\phi} ${0:${VISUAL:}}
endsnippet

context "math()"
snippet ;li "limit" iA
\\lim\\limits_\{$1\\to$2\}${0:${VISUAL:}}
endsnippet

context "math()"
snippet ;/ "Fraction" iA
\\frac\{${1:${VISUAL:}}\}\{$2\}$0
endsnippet

context "math()"
snippet ;f/ "Flat fraction" iA
\\flatfrac\{${1:${VISUAL:}}\}\{$2\}$0
endsnippet

context "math()"
snippet ;sq "Square root" iA
\\sqrt\{${1:${VISUAL:}}\}$0
endsnippet

context "math()"
snippet ;sin "Sin" iA
\\sin\\left(${1:${VISUAL:}}\\right)$0
endsnippet

context "math()"
snippet ;cos "Cos" iA
\\cos\\left(${1:${VISUAL:}}\\right)$0
endsnippet

context "math()"
snippet ;exp "Exp" iA
\\exp\\left[ ${1:${VISUAL:}} \\right]$0
endsnippet

context "math()"
snippet ;lp "Laplacian" iA
\\laplacian $0
endsnippet

context "math()"
snippet ;dal "D'Alembertian" iA
\\Box $0
endsnippet

context "math()"
snippet ;gr "gradient" iA
\\gradient $0
endsnippet

context "math()"
snippet ;di "divergence" iA
\\divergence $0
endsnippet

context "math()"
snippet ;cu "curl" iA
\\curl $0
endsnippet

context "math()"
snippet ;( "round bracket" iA
\\left(${1:${VISUAL:}}\\right)$0
endsnippet

context "math()"
snippet ;[ "square bracket" iA
\\left[${1:${VISUAL:}}\\right]$0
endsnippet

context "math()"
snippet ;{ "curly bracket" iA
\\left\\\{${1:${VISUAL:}}\\right\\\}$0
endsnippet

context "math()"
snippet ;| "abs value" iA
\\left|${1:${VISUAL:}}\\right|$0
endsnippet

context "math()"
snippet ;<< "mean value" iA
\\langle ${1:${VISUAL:}}\\rangle $0
endsnippet

context "math()"
snippet ;ev "evaluation" iA
\\eval\{${1:${VISUAL:}}\}_\{$2\}$0
endsnippet

context "math()"
snippet ;tx "text" iA
\\text\{${1:${VISUAL:}}\}$0
endsnippet

context "math()"
snippet ;~ "tilde" iA
\\tilde\{${1:${VISUAL:}}\}$0
endsnippet

context "math()"
snippet ;br "bra" iA
\\bra\{${1:${VISUAL:}}\}$0
endsnippet

context "math()"
snippet ;kk "ket" iA
\\ket\{${1:${VISUAL:}}\}$0
endsnippet

context "math()"
snippet ;S "Sigma (summation)" iA
\\sum_\{$1\}^\{$2\} ${0:${VISUAL:}}
endsnippet

context "math()"
snippet ;P "Pi (product)" iA
\\prod_\{$1\}^\{$2\} ${0:${VISUAL:}}
endsnippet

context "math()"
snippet ;inf "infinity" iA
\\infty$0
endsnippet

context "math()"
snippet ;hb "hbar" iA
\\hbar $0
endsnippet

#first argument is order, then variable then function
context "math()"
snippet ;dv "derivative" iA 
\\dv[$1]\{$2\}\{$3\}$0
endsnippet

context "math()"
snippet ;pdv "partial derivative" iA 
\\pdv[$1]\{$2\}\{$3\}$0
endsnippet

#------------------------------------------------------------------------------
